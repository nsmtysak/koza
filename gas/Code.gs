        items: {
          type: 'object',
          properties: {
            term: { type: 'string' },
            meaning: { type: 'string', description: '一言で。長い解説は要らない' }
          },
          required: ['term', 'meaning'],
          additionalProperties: false
        }
      },
      questions: {
        type: 'array',
        description: '一歩踏み込む問い。3〜5件。ここがいちばん大事',
        items: {
          type: 'object',
          properties: {
            ask: { type: 'string', description: 'その場で伺う言葉' },
            why: { type: 'string', description: 'なぜこの問いが効くか。答えから何が分かるか。1文' }
          },
          required: ['ask', 'why'],
          additionalProperties: false
        }
      },
      pitfalls: {
        type: 'array',
        description: '知らずに言うと軽く見られること。無ければ空配列',
        items: {
          type: 'object',
          properties: {
            dont: { type: 'string' },
            why: { type: 'string', description: 'なぜまずいか。1文' }
          },
          required: ['dont', 'why'],
          additionalProperties: false
        }
      },
      deeper: { type: 'string', description: '続けて追うなら何を見るか。1〜2文' }
    },
    required: ['topic', 'now', 'basics', 'questions', 'pitfalls', 'deeper'],
    additionalProperties: false
  };

  return callAndParse({
    model: model('think'),
    max_tokens: 4000,
    system: system,
    messages: [{
      role: 'user',
      content: JSON.stringify({ topic: topic, today: req.today })
    }],
    output_config: { effort: 'medium', format: { type: 'json_schema', schema: schema } }
  });
}

/* ============================================================
 * 7. お食事のお店を探す
 *
 * **ここは実際にウェブで調べる。** モデルの記憶で店を出してはいけない。
 *
 * 店は入れ替わる。閉まった店を「いま人気らしいですよ」と案内させたら、
 * 同伴が流れるどころか、その方の前で恥をかかせることになる。
 * 記憶で言えるのは「どういう店か」までで、「どの店か」は調べないと言えない。
 *
 * なぜこれが売上につながるのか。
 *   同伴は「日・お店・待ち合わせの時刻」の3つが揃って初めて成立する。
 *   お店が決まらない誘いは必ずもう一往復し、往復が増えるほど流れる。
 *   **お店の話から入れること**が、そのまま同伴の数になる。
 * しかも「いいお店を見つけました」は、お願いにならない誘い方でもある。
 *
 * 出すのは店の名前と、なぜその方に合うか。**予約はしない。確かめるのは本人。**
 * ============================================================ */

function handlePlaces(req) {
  var area = String(req.area || '').trim() || 'お店の周辺';
  var mealArea = String(req.meal_area || '').trim();
  var axis = String(req.axis || '').trim();
  var avoid = (req.avoid || []).slice(0, 6);
  var prefs = req.prefs || {};
  var ctx = req.context || {};

  var system = [
    industryPrimer(ctx),
    '# あなたの仕事',
    'お客様とお食事に行けるお店を探します。**お店は' + area + 'にあります。**',
    '**ウェブ検索を必ず使ってください。** あなたの記憶だけで店名を挙げてはいけません。',
    '',
    '# いちばん大事な条件 ── 場所',
    'お食事のあと、**ご一緒にお店へ向かえなければ意味がありません。**',
    'どれだけ評判のよいお店でも、そこから戻れないなら、そのお誘いは成立しません。',
    '',
    mealArea
      ? '**探す範囲は「' + mealArea + '」に限ります。ここから外れたお店は出さないでください。**'
      : '**探す範囲は' + area + 'から歩いて行ける範囲に限ります。**\n' +
        'タクシーで30分かかるような場所は、どれだけ良いお店でも出さないでください。',
    '',
    '**「世の中で人気のお店」を探しているのではありません。**',
    'ランキングの上位や、遠方の名店を挙げても、この仕事の役には立ちません。',
    '探しているのは「**この方に合って、そこからお店に戻れるお店**」です。',
    '',
    '# なぜ検索が要るのか',
    'お店は入れ替わります。閉まったお店を「いま評判だそうです」と案内させると、',
    'ホステス本人がお客様の前で恥をかき、そのお食事そのものが流れます。',
    '**確かめられなかったお店は、出さないでください。** 数を揃える必要はありません。',
    '',
    '# そのほかの条件',
    axis ? '- **この方のお好みの軸：' + axis + '**\n  ジャンルではなく、この軸に合うお店を探してください。' : '',
    (prefs.food || []).length ? '- お好きな食べ物：' + prefs.food.join('、') : '',
    (prefs.dislikes || []).length ? '- 苦手なもの：' + prefs.dislikes.join('、') + '（**これは外してください**）' : '',
    avoid.length ? '- **直近にお連れしたお店：' + avoid.join('、') + '**\n  同じお店も、同じ筋のお店も避けてください。' : '',
    '',
    '# 出し方',
    '- 3軒まで。**確かなものだけ**で構いません。1軒でも構いません。',
    '- name には、検索で確かめられた**実在するお店の名前**を入れます。',
    '- where には、場所と**お店からの距離感**を書きます。「堂島・歩いて7分ほど」のように。',
    '  ここが書けないお店は、範囲の外かもしれません。出さないでください。',
    '- why には、**なぜこの方に合うか**を1文。軸に照らして書いてください。',
    '- note には、本人が知っておくべきことを。予約の要否、カウンターの有無、個室、',
    '  お店の広さ、お一人あたりの目安など、**分かった範囲で**。',
    '- check には、**本人が予約前に確かめること**を必ず書きます。',
    '  営業しているか、その日空いているか。**あなたの調べは古いかもしれません。**',
    '',
    '# やってはいけないこと',
    '- **店名を作ること。** 見つからなければ空配列で返してください。',
    '- 予約が取れるかのように書くこと。取るのは本人です。',
    '- 「同伴」という言葉を使うこと。**お食事のお話**として書きます。',
    '- お客様のお名前を書くこと。ここはお店の話です。',
    '',
    '# 文体',
    'ホステス本人が読みます。短く。**そのお店の何が良いのか**が分かるように。'
  ].filter(String).join('\n');

  var schema = {
    type: 'object',
    properties: {
      places: {
        type: 'array',
        description: '確かめられたお店だけ。多くて3軒。無ければ空配列',
        items: {
          type: 'object',
          properties: {
            name: { type: 'string', description: '実在が確かめられたお店の名前' },
            where: { type: 'string', description: '場所と、お店からの距離感。「堂島・歩いて7分ほど」のように' },
            kind: { type: 'string', description: 'どういうお店か。短く' },
            why: { type: 'string', description: 'なぜこの方に合うか。軸に照らして1文' },
            note: { type: 'string', description: '知っておくとよいこと。分かった範囲で' },
            check: { type: 'string', description: '予約の前に本人が確かめること' }
          },
          required: ['name', 'where', 'kind', 'why', 'note', 'check'],
          additionalProperties: false
        }
      },
      note: { type: 'string', description: '見つからなかったときや、条件を緩めたときの断り。無ければ空文字' }
    },
    required: ['places', 'note'],
    additionalProperties: false
  };

  return callAndParse({
    model: model('think'),
    max_tokens: 6000,
    system: system,
    /* ウェブ検索。店の鮮度はここでしか担保できない。
     * 使いすぎないよう回数を絞る（1回のお願いで5回まで）。 */
    tools: [{ type: 'web_search_20260209', name: 'web_search', max_uses: 5 }],
    messages: [{
      role: 'user',
      content: JSON.stringify({ area: area, axis: axis, avoid: avoid, today: req.today })
    }],
    output_config: { effort: 'medium', format: { type: 'json_schema', schema: schema } }
  });
}

function man(n) {
  if (typeof n !== 'number' || !isFinite(n)) return '—';
  if (n >= 10000) return Math.round(n / 10000) + '万円';
  return n + '円';
}

/* ============================================================
 * Claude API 呼び出し
 * ============================================================ */

function callAndParse(body) {
  var res = callClaude(body);
  if (!res.ok) return res;
  var parsed = parseJsonText(res.text);
  if (!parsed) return { ok: false, error: 'AIの返事を読み取れませんでした' };
  // 使った量は本文と別に返す。data に混ぜると各画面の読み取りに紛れ込む
  return { ok: true, data: parsed, usage: res.usage || null };
}

function callClaude(body) {
  var key = PropertiesService.getScriptProperties().getProperty('ANTHROPIC_API_KEY');
  if (!key) return { ok: false, error: 'サーバー側のAPIキーが未設定です' };

  var res;
  try {
    res = UrlFetchApp.fetch(API_URL, {
      method: 'post',
      contentType: 'application/json',
      headers: { 'x-api-key': key, 'anthropic-version': API_VERSION },
      payload: JSON.stringify(body),
      muteHttpExceptions: true
    });
  } catch (err) {
    return { ok: false, error: 'AIに繋がりませんでした' };
  }

  var code = res.getResponseCode();
  var raw = res.getContentText();

  if (code !== 200) {
    var msg = 'AIが応答しませんでした（' + code + '）';
    try {
      var ej = JSON.parse(raw);
      var t = ej && ej.error && ej.error.type;
      if (t === 'rate_limit_error') msg = '混み合っています。少し置いて試してください';
      else if (t === 'authentication_error') msg = 'APIキーが正しくありません';
      else if (t === 'overloaded_error') msg = 'AI側が混雑しています';
      else if (t === 'invalid_request_error') msg = '依頼の形が正しくありません';
    } catch (e) { /* 生の本文は返さない */ }
    return { ok: false, error: msg };
  }

  var data;
  try { data = JSON.parse(raw); }
  catch (e) { return { ok: false, error: 'AIの返事を読み取れませんでした' }; }

  if (data.stop_reason === 'refusal') return { ok: false, error: 'この内容は扱えませんでした' };
  if (data.stop_reason === 'max_tokens') return { ok: false, error: '内容が長すぎました。分けて試してください' };

  /* ウェブ検索の途中で一度返ってくることがある（pause_turn）。
   *
   * サーバー側で検索を回している最中に区切りが来ると、まだ答えが出ていない状態で返る。
   * ここを見落とすと、text が空なら「中身が返りませんでした」、
   * 途中まで出ていれば**切れた JSON** になる。どちらも原因の分からない不具合になる。
   *
   * 続きを頼むときは、返ってきた中身をそのまま積んで投げ直す。
   * 「続けて」と足してはいけない（それ自体が新しい指示になってしまう）。
   * 何度も往復すると費用がかさむので、2回までにする。 */
  if (data.stop_reason === 'pause_turn' && (body.messages || []).length < 6) {
    var next = {};
    Object.keys(body).forEach(function (k) { next[k] = body[k]; });
    next.messages = body.messages.concat([{ role: 'assistant', content: data.content }]);
    return callClaude(next);
  }

  var text = '';
  (data.content || []).forEach(function (b) { if (b.type === 'text') text += b.text; });
  if (!text) return { ok: false, error: 'AIから中身が返りませんでした' };

  // 何トークン使ったかを持ち帰る。クレジットの減りは、推測ではなく実測で見せる
  var u = data.usage || {};
  return {
    ok: true,
    text: text,
    usage: {
      model: body.model || '',
      in: (u.input_tokens || 0) + (u.cache_read_input_tokens || 0) + (u.cache_creation_input_tokens || 0),
      out: u.output_tokens || 0
    }
  };
}

/* ============================================================
 * 補助
 * ============================================================ */

function model(kind) {
  var p = PropertiesService.getScriptProperties();
  if (kind === 'think') return p.getProperty('MODEL_THINK') || DEFAULT_THINK;
  return p.getProperty('MODEL_FAST') || DEFAULT_FAST;
}

function parseJsonText(text) {
  try { return JSON.parse(text); } catch (e) { /* 救済を試す */ }
  var s = text.indexOf('{'), t = text.lastIndexOf('}');
  if (s === -1 || t === -1 || t <= s) return null;
  try { return JSON.parse(text.substring(s, t + 1)); } catch (e) { return null; }
}

function safeEquals(a, b) {
  if (a.length !== b.length) return false;
  var diff = 0;
  for (var i = 0; i < a.length; i++) diff |= a.charCodeAt(i) ^ b.charCodeAt(i);
  return diff === 0;
}

function json(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}

/* ============================================================
 * 台帳（1人1つの合言葉）
 *
 * 1人で使っているうちは、スクリプトプロパティの TOKEN ひとつで足りる。
 * けれど複数の方にお配りするなら、それでは破綻する。
 *   - 1人が誰かに教えたら、全員が同じ鍵を使える
 *   - 誰がいくら使ったか分からない
 *   - 使いすぎを止められない
 *   - お辞めになった方を止められない
 *
 * そこでスプレッドシートを台帳にして、1人1行で持つ。
 * 端末側の申告は当てにしない。**数えるのはここだけ。**
 *
 * LEDGER_ID（スクリプトプロパティ）が無いときは、これまでどおり TOKEN で動く。
 * 1人で使っている間は、何も変えなくてよい。
 *
 * ■ 列（1行目は見出し）
 *   A 合言葉 / B お名前 / C 状態(有効・停止) / D 月の上限(回。0＝無制限)
 *   E 集計月 / F 今月の回数 / G 送ったトークン / H 返ったトークン
 *   I 最後に使った日時 / J 備考
 * ============================================================ */

var LEDGER_SHEET = 'users';
var LEDGER_HEAD = ['合言葉', 'お名前', '状態', '月の上限', '集計月', '今月の回数',
                   '送った', '返った', '最後に使った', '備考'];

function ledgerSheet_() {
  var id = PropertiesService.getScriptProperties().getProperty('LEDGER_ID');
  if (!id) return null;
  try {
    var ss = SpreadsheetApp.openById(id);
    return ss.getSheetByName(LEDGER_SHEET) || ss.getSheets()[0];
  } catch (e) {
    console.error('台帳を開けません');
    return null;
  }
}

function monthKey_() {
  return Utilities.formatDate(new Date(), Session.getScriptTimeZone() || 'Asia/Tokyo', 'yyyy-MM');
}

/**
 * 合言葉を確かめて、使ってよいかを返す。
 * 台帳が無ければ、これまでどおり TOKEN ひとつで通す（1人用）。
 */
function authorize_(token) {
  token = String(token || '');
  if (!token) return { ok: false, error: '合言葉が違います' };

  var sh = ledgerSheet_();
  if (!sh) {
    var expected = PropertiesService.getScriptProperties().getProperty('TOKEN');
    if (!expected) return { ok: false, error: 'サーバー側の合言葉が未設定です' };
    if (!safeEquals(token, expected)) return { ok: false, error: '合言葉が違います' };
    return { ok: true, sheet: null, row: 0 };
  }

  var v = sh.getDataRange().getValues();
  var month = monthKey_();

  for (var i = 1; i < v.length; i++) {
    if (!safeEquals(String(v[i][0] || '').trim(), token)) continue;

    var status = String(v[i][2] || '').trim();
    if (status && status !== '有効') {
      return { ok: false, error: 'ご利用が止まっています。お手数ですが管理者にご連絡ください' };
    }

    // 月が変わっていたら、数え直しとして扱う
    var same = String(v[i][4] || '') === month;
    var calls = same ? Number(v[i][5] || 0) : 0;
    var limit = Number(v[i][3] || 0);
    if (limit > 0 && calls >= limit) {
      return { ok: false, error: '今月のご利用が上限に達しました。お手数ですが管理者にご連絡ください' };
    }

    return { ok: true, sheet: sh, row: i + 1, name: String(v[i][1] || ''), month: month };
  }
  return { ok: false, error: '合言葉が違います' };
}

/** 使った分を台帳に足す。ここが唯一の集計元 */
function ledgerRecord_(auth, usage) {
  if (!auth || !auth.sheet || !auth.row) return;

  var lock = LockService.getScriptLock();
  try { lock.waitLock(8000); } catch (e) { return; }   // 取れなければ数えない。止めるほどではない

  try {
    var sh = auth.sheet, r = auth.row;
    var cur = sh.getRange(r, 5, 1, 4).getValues()[0];        // E〜H
    var same = String(cur[0] || '') === auth.month;
    sh.getRange(r, 5, 1, 4).setValues([[
      auth.month,
      (same ? Number(cur[1] || 0) : 0) + 1,
      (same ? Number(cur[2] || 0) : 0) + ((usage && usage['in']) || 0),
      (same ? Number(cur[3] || 0) : 0) + ((usage && usage.out) || 0)
    ]]);
    sh.getRange(r, 9).setValue(new Date());
  } finally {
    lock.releaseLock();
  }
}

/* ------------------------------------------------------------
 * ここから下は、エディタの「実行」から手で動かすもの
 * ------------------------------------------------------------ */

/** ① 台帳を作る。一度だけ実行する */
function setupLedger() {
  var props = PropertiesService.getScriptProperties();
  if (props.getProperty('LEDGER_ID')) {
    console.log('もうあります: ' + ledgerUrl());
    return;
  }
  var ss = SpreadsheetApp.create('Kōza 台帳');
  var sh = ss.getSheets()[0];
  sh.setName(LEDGER_SHEET);
  sh.getRange(1, 1, 1, LEDGER_HEAD.length).setValues([LEDGER_HEAD]).setFontWeight('bold');
  sh.setFrozenRows(1);
  sh.setColumnWidth(1, 260);
  props.setProperty('LEDGER_ID', ss.getId());
  console.log('台帳を作りました: ' + ss.getUrl());
  console.log('次は issueKey を実行して、1人目の合言葉を発行してください。');
}

/** ② 合言葉を1つ発行する。実行するたびに1行増える */
function issueKey() {
  var sh = ledgerSheet_();
  if (!sh) { console.log('先に setupLedger を実行してください'); return; }

  var key = 'k_' + Utilities.getUuid().replace(/-/g, '');
  sh.appendRow([key, '（お名前を入れてください）', '有効', 900, monthKey_(), 0, 0, 0, '', '']);
  console.log('発行しました。この1行をお渡しください。');
  console.log(key);
  console.log('※ 月の上限は900回にしてあります。台帳のD列で変えられます。');
  console.log('※ お名前は台帳のB列に直接お書きください。');
}

/** ③ 今の状況を見る */
function showLedger() {
  var sh = ledgerSheet_();
  if (!sh) { console.log('台帳がありません（1人用のまま動いています）'); return; }
  var v = sh.getDataRange().getValues();
  if (v.length < 2) { console.log('まだ誰も登録されていません'); return; }

  var month = monthKey_();
  var totalIn = 0, totalOut = 0;
  for (var i = 1; i < v.length; i++) {
    var same = String(v[i][4] || '') === month;
    var calls = same ? Number(v[i][5] || 0) : 0;
    var tin = same ? Number(v[i][6] || 0) : 0;
    var tout = same ? Number(v[i][7] || 0) : 0;
    totalIn += tin; totalOut += tout;
    console.log([
      (v[i][1] || '（名なし）'),
      (v[i][2] || '有効'),
      calls + '回',
      '送' + tin + ' / 返' + tout,
      '鍵…' + String(v[i][0]).slice(-6)
    ].join('　'));
  }
  // ざっくりの目安。正確な請求は Anthropic の管理画面で見ること
  var usd = (totalIn / 1e6) * 3 + (totalOut / 1e6) * 15;
  console.log('---');
  console.log(month + ' 合計　送' + totalIn + ' / 返' + totalOut +
    '　おおよそ $' + (Math.round(usd * 100) / 100));
}

/** ④ 止める・戻す。台帳のC列を直接書き換えても同じ */
function suspendKey() {
  console.log('台帳のC列を「停止」に書き換えてください。次の呼び出しから止まります。');
  console.log(ledgerUrl());
}

function ledgerUrl() {
  var id = PropertiesService.getScriptProperties().getProperty('LEDGER_ID');
  return id ? 'https://docs.google.com/spreadsheets/d/' + id + '/edit' : '（台帳なし）';
}
