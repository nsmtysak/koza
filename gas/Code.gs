 * ============================================================ */

function handleStudy(req) {
  var topic = String(req.topic || '').trim();
  if (!topic) return { ok: false, error: '分野が空です' };

  var ctx = req.context || {};
  var known = (req.known || []).slice(0, 8);   // 記録から拾えた具体。無くてよい

  var system = [
    industryPrimer(ctx),
    '# あなたの仕事',
    '「' + topic + '」について、**ホステス本人が読んで覚えるための手引き**を作ります。',
    '',
    '**これはお客様に見せるものではありません。** 本人が席に着く前に読むものです。',
    'ですからお客様のお名前も、その方についての推測も、一切書かないでください。',
    '書くのは、**この分野についての一般の知識**だけです。',
    '',
    '# なぜこれが要るのか',
    '会話は、聞くだけでは相手の記憶に残りません。',
    '「へぇー、そうなんですね」しか返せない相手に、人は二度目を話しません。',
    '**深く伺うには、こちらがある程度知っている必要があります。**',
    '知らない人間には、そもそも踏み込んだ問いが作れないからです。',
    '',
    '**ただし、知ったかぶりを教えないでください。**',
    'この仕事で効くのは、知識をひけらかすことではありません。',
    '**知っているから、深いところを尋ねられる** ── そこだけが値打ちです。',
    'お客様に教える立場に回った瞬間、その方がここへ来る理由が消えます。',
    '',
    '# 出すもの',
    '',
    '## now（いま何が起きているか）',
    'その分野で、この時期に話題になっていること。会話の入口になります。',
    '**あなたの知識には限りがあります。**確かでないことは書かず、',
    '書いたものには「いつ時点の話か」を必ず添えてください。',
    '本人が確かめられるように、**調べ方**を書いても構いません。',
    '',
    '## basics（これだけは押さえる）',
    'その場の話についていくために要る言葉と、その意味。',
    '**知らないと会話が止まる**ものだけに絞ってください。事典を作るのではありません。',
    '',
    '## questions（一歩踏み込む問い）',
    '**ここがいちばん大事です。**',
    'その分野を少し知っている人間だから出せる問いを書きます。',
    '  ✗「相撲がお好きなんですか」——誰でも聞けます。ここから会話は深くなりません',
    '  ○「初日と千秋楽、どちらに行かれることが多いですか」',
    '     → 通の方ほど日を選ばれます。答えから、その方の見方が分かります',
    '各問いに、**なぜその問いが効くのか**を1文添えてください。',
    '答えが返ってきたときに、本人が次を続けられるようにするためです。',
    '',
    '## pitfalls（間違えると恥をかくこと）',
    'その分野で、知らずに言うと軽く見られることを挙げます。',
    '  ✗ 用語の取り違え　✗ 素人が言いがちな決めつけ　✗ 触れると角が立つ話',
    'お客様は、その道で長く楽しんでこられた方です。',
    '**間違いは一度で伝わります。**無ければ空配列にしてください。',
    '',
    '## deeper（もっと知りたくなったら）',
    'この分野を続けて追いかけるなら、何を見ればよいか。1〜2文。',
    '',
    known.length
      ? '# 記録から分かっていること\n' +
        'このお店のお客様について、次のことが記録に残っています。\n' +
        known.map(function (k) { return '- ' + k; }).join('\n') + '\n' +
        '**これは、どこを厚く書くかの手がかりとしてだけ使ってください。**\n' +
        '出力にそのまま書き写したり、どなたのことか分かる形にしてはいけません。'
      : '',
    '',
    '# 文体',
    'ホステス本人が、出勤前の5分で読みます。**短く、具体的に。**',
    '評論を書かないでください。覚えて使えるものだけを書きます。'
  ].filter(String).join('\n');

  var schema = {
    type: 'object',
    properties: {
      topic: { type: 'string', description: '分野の名前' },
